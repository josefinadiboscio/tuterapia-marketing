# Copiar a .env.local para desarrollo. Nunca commitear valores reales.
# En produccion estas variables se cargan en Vercel (Project Settings > Environment Variables).

# Secreto del cron. Vercel Cron lo manda solo como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# MySQL de solo lectura (tuterapiaweb)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=tuterapiaweb
# "true" si el servidor exige TLS
MYSQL_SSL=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres directo. El schema marketing no esta expuesto en la API y el job
# necesita transacciones reales.
#
# Alcanza con la password de la base: la URL se arma sola a partir de
# NEXT_PUBLIC_SUPABASE_URL. Settings > Database > Reset database password.
SUPABASE_DB_PASSWORD=
# Opcional, solo si se quiere forzar una cadena de conexion completa.
SUPABASE_DB_URL=

# Puerta temporal del dashboard, hasta que este Supabase Auth con el dominio
# de la empresa. Sin este valor no entra nadie.
DASHBOARD_PASSWORD=
